rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null && 
        (request.auth.token.email_verified == true || 
         request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isSuperAdminEmail() {
      return request.auth.token.email in [
        "maitreya.mul@gmail.com",
        "manishm9730@gmail.com",
        "zorbainfotech@gmail.com",
        "zorbasquad@gmail.com",
        "maitreyam@google.com"
      ];
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // Allow authenticated users to check their own admin doc; only super-admins can grant admin access
    match /admins/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow write: if isAuthenticated() && isSuperAdminEmail();
    }

    // Public catalog items: Anyone can view product & category listings
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isBackupExecutive() {
      return isAuthenticated() && request.auth.token.email in [
        "maitreya.mul@gmail.com",
        "manishm9730@gmail.com",
        "zorbainfotech@gmail.com"
      ];
    }

    // Restrict disaster recovery backups collection to executive owners only
    match /backups/{backupId} {
      allow read, write: if isBackupExecutive();
    }

    // Authorized Admin Collections
    match /service_calls/{ticketId} {
      allow read, write: if isAdmin();
      match /timeline/{eventId} {
        allow read, write: if isAdmin();
      }
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /team_members/{memberId} {
      allow read, write: if isAdmin();
    }

    match /service_centers/{centerId} {
      allow read, write: if isAdmin();
    }

    match /couriers/{courierId} {
      allow read, write: if isAdmin();
    }

    match /device_models/{modelId} {
      allow read, write: if isAdmin();
    }

    match /device_categories/{categoryId} {
      allow read, write: if isAdmin();
    }

    match /spare_parts/{partId} {
      allow read, write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    match /whatsapp_templates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /financial_years/{fyId}/{allSubcollections=**} {
      allow read, write: if isAdmin();
    }
  }
}
