rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated with one of the authorized admin emails
    function isSuperAdmin() {
      return request.auth != null && 
        (request.auth.token.email == "maitreya.mul@gmail.com" ||
         request.auth.token.email == "manishm9730@gmail.com" ||
         request.auth.token.email == "zorbainfotech@gmail.com" ||
         request.auth.token.email == "maitreyam@google.com");
    }

    // Public catalog items: Anyone can view product & category listings
    match /products/{productId} {
      allow read: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
    }

    // Allow full read and write access on all documents for authorized admin accounts
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
